# Isolated ChatGPT subscription Codex CLI runner, built by the researcher.
# This container is never given a host project directory or private gold.
FROM node:22-bookworm-slim
ARG CODEX_CLI_VERSION=latest
RUN npm install --global "@openai/codex@${CODEX_CLI_VERSION}" \
    && codex --version
# The Python runner overrides ENTRYPOINT with /bin/sh and supplies only
# the auth.json single-file bind plus an empty temporary /work mount.
WORKDIR /work
